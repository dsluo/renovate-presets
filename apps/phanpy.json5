{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Phanpy releases use YYYY.MM.DD.<commit-sha> tags",
      matchDatasources: ["github-releases", "github-tags"],
      matchPackageNames: ["cheeaun/phanpy"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.[a-f0-9]+$",
    },
    {
      description: "Phanpy uses YYYY.MM.DD.<commit-sha> tags; use upstream release notes",
      matchDatasources: ["docker"],
      matchPackageNames: ["/(^|/)phanpy$/"],
      sourceUrl: "https://github.com/cheeaun/phanpy",
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.[a-f0-9]+$",
    },
  ],
}
